# Copie para .env e substitua por valores únicos. NUNCA publique o arquivo .env.
MYSQL_DATABASE=isadora
MYSQL_USER=isadora
MYSQL_PASSWORD=SUBSTITUIR_POR_SENHA_FORTE
MYSQL_ROOT_PASSWORD=SUBSTITUIR_POR_OUTRA_SENHA_FORTE
TOKEN_SECRET=SUBSTITUIR_POR_CHAVE_ALEATORIA_COM_64_CARACTERES
SESSION_SECRET=SUBSTITUIR_POR_OUTRA_CHAVE_ALEATORIA_COM_64_CARACTERES
# Crie o hash localmente: python -c "from werkzeug.security import generate_password_hash; import getpass; print(generate_password_hash(getpass.getpass()))"
# Coloque o hash entre aspas simples: $ não deve ser interpolado pelo Docker Compose.
ORGANIZER_USERNAME=organizador
ORGANIZER_PASSWORD_HASH='GERAR_HASH_SEGURO_NAO_USAR_SENHA_EM_TEXTO'
APP_PUBLIC_URL=http://localhost:8080
